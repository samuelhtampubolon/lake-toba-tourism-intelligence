# Lake Toba Tourism Intelligence - Environment Configuration
# Deployment environment: 'development', 'lan', or 'production'
ENVIRONMENT=development

# Application Secret Key (min 32 characters, used for session cryptographic integrity)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET_KEY=change-me-to-a-very-secure-random-token-at-least-32-chars-long

# Host and Port configuration
HOST=127.0.0.1
PORT=8000

# Storage & Database paths
DATA_DIR=data
DATABASE_URL=sqlite:///data/lake_toba.sqlite

# Session settings
SESSION_COOKIE_NAME=toba_session
SESSION_EXPIRE_MINUTES=480
SESSION_INACTIVITY_MINUTES=60
COOKIE_SECURE=false

# Timezone defaults
APP_TIMEZONE=Asia/Jakarta

# Upload & Resource bounds
MAX_UPLOAD_SIZE_BYTES=10485760
MAX_CSV_ROWS=50000
